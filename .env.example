# ─────────────────────────────────────────────────────────────
#  Prepo — copy to .env and fill in. Only three values are
#  actually required to boot; everything else has a default.
# ─────────────────────────────────────────────────────────────

# ── required ─────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:prepo@localhost:5432/prepo

# Generate each of these with:  pnpm keygen
AUTH_SECRET=
ENCRYPTION_KEY=

# ── LLM providers ────────────────────────────────────────────
# Set one here, or leave blank and let each user paste their own
# key in Settings. Keys added in the UI are encrypted at rest
# with ENCRYPTION_KEY and always win over these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
# e.g. http://localhost:11434  (from Docker: http://host.docker.internal:11434)

DEFAULT_PROVIDER=anthropic

# ── model tiers ──────────────────────────────────────────────
# Tiers are names, not model IDs. Leave blank to use the
# provider default from packages/llm/src/models.json.
MODEL_FAST=
MODEL_BALANCED=
MODEL_FRONTIER=

# ── embeddings ───────────────────────────────────────────────
# auto | openai | google | ollama | local
#   auto  picks ollama -> openai -> google -> local
#   local is a dependency-free hashing embedder: works offline,
#         retrieval quality is noticeably worse. Fine for a demo.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=

# ── auth ─────────────────────────────────────────────────────
# true  = no login screen at all, everything scoped to one local
#         user. The right setting for a personal self-host.
SINGLE_USER_MODE=true

# Comma separated: github,google,email
AUTH_PROVIDERS=github
APP_URL=http://localhost:3000

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link email. With no SMTP configured the link is printed
# to the server log, which is all you need in development.
SMTP_URL=
SMTP_FROM=prepo@localhost
ALLOWED_EMAIL_DOMAINS=

# ── limits & behaviour ───────────────────────────────────────
MAX_REPO_MB=500
MAX_FILES=25000
MAX_FILE_KB=400
BUDGET_CENTS_PER_RUN=200
JOB_CONCURRENCY=2
WORK_DIR=/tmp/prepo-work

# local | s3
STORAGE_DRIVER=local
STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── observability ────────────────────────────────────────────
# Nothing leaves your machine unless you turn this on.
TELEMETRY=off
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LOG_LEVEL=info
